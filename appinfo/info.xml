<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>brtop</id>
    <name>BR TOP- und Sitzungsverwaltung</name>
    <summary>Prototyp zur Erstellung von Ladungen, Protokollvorlagen und Beschlussdokumenten für Betriebsratsarbeit.</summary>
    <description>Verwaltet Sitzungen, TOPs, versiegelte Legislatur- und Ladungssnapshots, Protokollvorlagen und Beschlussdokumente.</description>
    <version>0.1.34</version>
    <licence>agpl</licence>
    <author>Simon / ChatGPT-Prototyp</author>
    <namespace>BrTop</namespace>
    <category>organization</category>
    <bugs>https://example.invalid</bugs>
    <dependencies>
        <nextcloud min-version="29" max-version="35"/>
        <app>calendar</app>
        <app>localbase</app>
        <app>orgsuite</app>
    </dependencies>
    <settings>
        <admin>OCA\BrTop\Settings\Admin</admin>
        <admin-section>OCA\BrTop\Settings\AdminSection</admin-section>
    </settings>
    <repair-steps>
        <post-migration>
            <step>OCA\BrTop\Migration\EnsureBrGroupsStep</step>
        </post-migration>
        <install>
            <step>OCA\BrTop\Migration\EnsureBrGroupsStep</step>
        </install>
    </repair-steps>
</info>
